          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Yes, you have room: about 100 hours of schedulable time this week, far more than the three hours this task needs."
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "name": "get_capacity",
                "args": {
                  "workspace_id": "eval-room"
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
