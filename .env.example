# Environment configuration for the Blink API & agent runtime
PORT=8080
ENV=production

# Google Gemini & ADK credentials.
# Local dev only. In production the runtime service account gets keyless Vertex
# access instead, so no API key ever lands in the image.
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Vertex AI path (what production uses; recommended if you have a GCP project).
# Set the three below and flip GOOGLE_GENAI_USE_VERTEXAI=TRUE, then authenticate
# with `gcloud auth application-default login`. No API key needed on this path.
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# Google OAuth client, for connecting a calendar. The real client secret comes
# from Secret Manager in production (see deployment/deploy.sh --set-secrets).
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth/callback

# Signs the session cookie that binds a Google account to its workspace. Any
# long random string works locally; production reads it from Secret Manager.
# Leave it unset and Google sign-in stays disabled, which is a fine local state.
BLINK_SESSION_SECRET=

# Durable state. Firestore is off by default so local runs stay in memory.
BLINK_FIRESTORE=0
FIRESTORE_DATABASE=blink

# Note: webhook signing secrets are per subscription. A caller supplies one when
# it registers a webhook, so there is no global WEBHOOK_SECRET to configure.
